public class HidControllerService extends Service {
    public static final String ACTION_STATUS = "com.mggx.minecrafttouchhid.STATUS";
    public static final String EXTRA_STATUS = "status";
    public static final String EXTRA_ADDRESS = "address";

    public static final String CMD_INIT = "init";
    public static final String CMD_CONNECT = "connect";
    public static final String CMD_SHOW_OVERLAY = "show_overlay";
    public static final String CMD_HIDE_OVERLAY = "hide_overlay";

    private static final int NOTIFICATION_ID = 6101;
    private static final String CHANNEL_ID = "minecraft_touch_hid";
    private static final int KEYBOARD_REPORT_ID = 1;
    private static final int MOUSE_REPORT_ID = 2;

    private static final byte[] REPORT_DESCRIPTOR = new byte[] {
            // Keyboard, Report ID 1
            0x05, 0x01, 0x09, 0x06, (byte) 0xA1, 0x01,
            (byte) 0x85, 0x01,
            0x05, 0x07,
            0x19, (byte) 0xE0, 0x29, (byte) 0xE7,
            0x15, 0x00, 0x25, 0x01,
            0x75, 0x01, (byte) 0x95, 0x08,
            (byte) 0x81, 0x02,
            (byte) 0x95, 0x01, 0x75, 0x08,
            (byte) 0x81, 0x01,
            (byte) 0x95, 0x06, 0x75, 0x08,
            0x15, 0x00, 0x25, 0x65,
            0x05, 0x07, 0x19, 0x00, 0x29, 0x65,
            (byte) 0x81, 0x00,
            (byte) 0xC0,

            // Mouse, Report ID 2 (5 buttons + X/Y + wheel)
            0x05, 0x01, 0x09, 0x02, (byte) 0xA1, 0x01,
            (byte) 0x85, 0x02,
            0x09, 0x01, (byte) 0xA1, 0x00,
            0x05, 0x09,
            0x19, 0x01, 0x29, 0x05,
            0x15, 0x00, 0x25, 0x01,
            (byte) 0x95, 0x05, 0x75, 0x01,
            (byte) 0x81, 0x02,
            (byte) 0x95, 0x01, 0x75, 0x03,
            (byte) 0x81, 0x01,
            0x05, 0x01,
            0x09, 0x30, 0x09, 0x31, 0x09, 0x38,
            0x15, (byte) 0x81, 0x25, 0x7F,
            0x75, 0x08, (byte) 0x95, 0x03,
            (byte) 0x81, 0x06,
            (byte) 0xC0, (byte) 0xC0
    };

    private BluetoothAdapter adapter;
    private BluetoothHidDevice hid;
    private BluetoothDevice connectedDevice;
    private boolean appRegistered;
    private String pendingAddress;
    private final Set<Integer> heldKeys = new LinkedHashSet<>();
    private byte modifiers;
    private byte mouseButtons;

    private WindowManager windowManager;
    private MinecraftOverlayView overlayView;
    private Button modeToggleView;
    private boolean controlsEnabled;

    private final BluetoothProfile.ServiceListener profileListener = new BluetoothProfile.ServiceListener() {
        @Override public void onServiceConnected(int profile, BluetoothProfile proxy) {
            if (profile != BluetoothProfile.HID_DEVICE || !(proxy instanceof BluetoothHidDevice)) return;
            hid = (BluetoothHidDevice) proxy;
            registerHidApp();
        }

        @Override public void onServiceDisconnected(int profile) {
            if (profile == BluetoothProfile.HID_DEVICE) {
                hid = null;
                appRegistered = false;
                connectedDevice = null;
                broadcastStatus("Servicio HID Bluetooth desconectado.");
            }
        }
    };

    private final BluetoothHidDevice.Callback hidCallback = new BluetoothHidDevice.Callback() {
        @Override public void onAppStatusChanged(BluetoothDevice pluggedDevice, boolean registered) {
            appRegistered = registered;
            if (registered) {
                broadcastStatus("HID listo. Elegí tu PC emparejada.");
                if (pendingAddress != null) connectToAddress(pendingAddress);
            } else {
                connectedDevice = null;
                broadcastStatus("No se pudo registrar el perfil HID. Mantené la app activa e intentá de nuevo.");
            }
        }

        @Override public void onConnectionStateChanged(BluetoothDevice device, int state) {
            if (state == BluetoothProfile.STATE_CONNECTED) {
                connectedDevice = device;
                String name = safeDeviceName(device);
                getSharedPreferences("controls", MODE_PRIVATE).edit()
                        .putString("last_device", device.getAddress()).apply();
                broadcastStatus("Conectado a " + name + " como teclado + mouse. Ya podés abrir Moonlight.");
            } else if (state == BluetoothProfile.STATE_CONNECTING) {
                broadcastStatus("Conectando HID a " + safeDeviceName(device) + "…");
            } else if (state == BluetoothProfile.STATE_DISCONNECTED &&
                    connectedDevice != null && connectedDevice.equals(device)) {
                releaseAll();
                connectedDevice = null;
                broadcastStatus("HID desconectado de " + safeDeviceName(device) + ".");
            }
        }
    };

    @Override public void onCreate() {
        super.onCreate();
        startForeground(NOTIFICATION_ID, buildNotification("Preparando teclado y mouse Bluetooth…"));
        BluetoothManager manager = getSystemService(BluetoothManager.class);
        adapter = manager != null ? manager.getAdapter() : null;
        windowManager = (WindowManager) getSystemService(WINDOW_SERVICE);
        initBluetoothProfile();
    }

    @Override public int onStartCommand(Intent intent, int flags, int startId) {
        String action = intent != null ? intent.getAction() : null;
        if (action == null) action = CMD_INIT;
        if (hid == null) initBluetoothProfile();

        switch (action) {
            case CMD_CONNECT:
                String address = intent.getStringExtra(EXTRA_ADDRESS);
                if (address != null) {
                    pendingAddress = address;
                    connectToAddress(address);
                }
                break;
            case CMD_SHOW_OVERLAY:
                showOverlay();
                break;
            case CMD_HIDE_OVERLAY:
                hideOverlay();
                break;
            case CMD_INIT:
            default:
                maybeAutoConnect();
                break;
        }
        return START_STICKY;
    }
