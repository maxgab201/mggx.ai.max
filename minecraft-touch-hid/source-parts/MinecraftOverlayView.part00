package com.mggx.minecrafttouchhid;

import android.content.Context;
import android.content.SharedPreferences;
import android.graphics.Canvas;
import android.graphics.Color;
import android.graphics.Paint;
import android.graphics.RectF;
import android.view.MotionEvent;
import android.view.View;

import java.util.HashMap;
import java.util.HashSet;
import java.util.Map;
import java.util.Set;

import static com.mggx.minecrafttouchhid.HidControllerService.HidCodes;

public class MinecraftOverlayView extends View {
    private final HidControllerService controller;
    private final SharedPreferences prefs;
    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
    private final Paint stroke = new Paint(Paint.ANTI_ALIAS_FLAG);
    private final Paint text = new Paint(Paint.ANTI_ALIAS_FLAG);
    private final Paint active = new Paint(Paint.ANTI_ALIAS_FLAG);

    private final Map<Integer, String> pointerZones = new HashMap<>();
    private int joystickPointer = -1;
    private int lookPointer = -1;
    private float lookLastX;
    private float lookLastY;
    private float joystickX;
    private float joystickY;
    private Set<Integer> lastMovement = new HashSet<>();

    public MinecraftOverlayView(Context context, HidControllerService controller) {
        super(context);
        this.controller = controller;
        this.prefs = context.getSharedPreferences("controls", Context.MODE_PRIVATE);
        setFocusable(false);
        setFocusableInTouchMode(false);
        setSystemUiVisibility(SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                | SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
                | SYSTEM_UI_FLAG_LAYOUT_STABLE);
    }

    @Override protected void onDraw(Canvas canvas) {
        super.onDraw(canvas);
        int w = getWidth();
        int h = getHeight();
        if (w <= 0 || h <= 0) return;
        float s = Math.min(w, h);
        int alpha = Math.max(40, Math.min(230, prefs.getInt("opacity", 105)));

        fill.setColor(Color.argb(alpha, 20, 24, 30));
        stroke.setColor(Color.argb(Math.min(255, alpha + 80), 245, 247, 250));
        stroke.setStyle(Paint.Style.STROKE);
        stroke.setStrokeWidth(Math.max(2f, s * 0.003f));
        text.setColor(Color.argb(Math.min(255, alpha + 110), 255, 255, 255));
        text.setTextAlign(Paint.Align.CENTER);
        text.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
        active.setColor(Color.argb(Math.min(230, alpha + 70), 105, 190, 255));

        float joyCx = w * 0.14f;
        float joyCy = h * 0.72f;
        float joyR = s * 0.13f;
        canvas.drawCircle(joyCx, joyCy, joyR, fill);
        canvas.drawCircle(joyCx, joyCy, joyR, stroke);
        float knobX = joystickPointer >= 0 ? joystickX : joyCx;
        float knobY = joystickPointer >= 0 ? joystickY : joyCy;
        canvas.drawCircle(knobX, knobY, joyR * 0.42f, joystickPointer >= 0 ? active : fill);
        canvas.drawCircle(knobX, knobY, joyR * 0.42f, stroke);
        text.setTextSize(s * 0.036f);
        canvas.drawText("WASD", joyCx, joyCy + s * 0.012f, text);

        drawButton(canvas, w * 0.12f, h * 0.47f, s * 0.055f, "SPR", isZoneHeld("sprint"));
        drawButton(canvas, w * 0.30f, h * 0.80f, s * 0.055f, "SNEAK", isZoneHeld("sneak"));

        drawButton(canvas, w * 0.89f, h * 0.57f, s * 0.073f, "ATK", isZoneHeld("attack"));
        drawButton(canvas, w * 0.76f, h * 0.70f, s * 0.064f, "USE", isZoneHeld("use"));
        drawButton(canvas, w * 0.90f, h * 0.80f, s * 0.070f, "JUMP", isZoneHeld("jump"));
        drawButton(canvas, w * 0.68f, h * 0.54f, s * 0.043f, "▲", false);
        drawButton(canvas, w * 0.68f, h * 0.65f, s * 0.043f, "▼", false);

        drawButton(canvas, w * 0.67f, h * 0.10f, s * 0.044f, "F3", isZoneHeld("f3"));
        drawButton(canvas, w * 0.76f, h * 0.10f, s * 0.044f, "Q", isZoneHeld("q"));
        drawButton(canvas, w * 0.85f, h * 0.10f, s * 0.044f, "INV", isZoneHeld("inventory"));
        drawButton(canvas, w * 0.94f, h * 0.10f, s * 0.044f, "ESC", isZoneHeld("esc"));

        float barLeft = w * 0.34f;
        float barRight = w * 0.66f;
        float barTop = h * 0.885f;
        float barBottom = h * 0.985f;
        float cell = (barRight - barLeft) / 9f;
        text.setTextSize(s * 0.028f);
        for (int i = 0; i < 9; i++) {
            RectF r = new RectF(barLeft + i * cell, barTop, barLeft + (i + 1) * cell, barBottom);
            canvas.drawRoundRect(r, s * 0.012f, s * 0.012f, isZoneHeld("slot" + (i + 1)) ? active : fill);
            canvas.drawRoundRect(r, s * 0.012f, s * 0.012f, stroke);
            canvas.drawText(String.valueOf(i + 1), r.centerX(), r.centerY() + s * 0.010f, text);
        }

        RectF close = new RectF(w * 0.47f, h * 0.018f, w * 0.53f, h * 0.082f);
        canvas.drawRoundRect(close, s * 0.015f, s * 0.015f, fill);
        canvas.drawRoundRect(close, s * 0.015f, s * 0.015f, stroke);
        text.setTextSize(s * 0.020f);
        canvas.drawText("TOUCH", close.centerX(), close.centerY() + s * 0.008f, text);

        text.setTextSize(s * 0.024f);
        text.setColor(Color.argb(Math.max(55, alpha - 20), 255, 255, 255));
        canvas.drawText("LOOK / MOUSE", w * 0.62f, h * 0.42f, text);
    }

    private void drawButton(Canvas canvas, float x, float y, float r, String label, boolean pressed) {
        canvas.drawCircle(x, y, r, pressed ? active : fill);
        canvas.drawCircle(x, y, r, stroke);
        text.setTextSize(Math.max(16f, r * (label.length() > 3 ? 0.42f : 0.62f)));
        canvas.drawText(label, x, y - (text.ascent() + text.descent()) / 2f, text);
    }

    @Override public boolean onTouchEvent(MotionEvent event) {
        int action = event.getActionMasked();
        int index = event.getActionIndex();
        int pointerId = event.getPointerId(index);

        if (action == MotionEvent.ACTION_DOWN || action == MotionEvent.ACTION_POINTER_DOWN) {
            handleDown(pointerId, event.getX(index), event.getY(index));
        } else if (action == MotionEvent.ACTION_MOVE) {
            for (int i = 0; i < event.getPointerCount(); i++) {
                int id = event.getPointerId(i);
                handleMove(id, event.getX(i), event.getY(i));
            }
        } else if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_POINTER_UP) {
            handleUp(pointerId);
        } else if (action == MotionEvent.ACTION_CANCEL) {
            cancelAllPointers();
        }
        invalidate();
        return true;
    }

    private void handleDown(int id, float x, float y) {
        int w = getWidth();
        int h = getHeight();
        float s = Math.min(w, h);

        if (x >= w * 0.47f && x <= w * 0.53f && y >= h * 0.018f && y <= h * 0.082f) {
            pointerZones.put(id, "hide");
            post(controller::disableControlsForTouch);
            return;
        }

        float joyCx = w * 0.14f;
        float joyCy = h * 0.72f;
        float joyR = s * 0.13f;
        if (joystickPointer < 0 && distance(x, y, joyCx, joyCy) <= joyR * 1.25f) {
            joystickPointer = id;
            pointerZones.put(id, "joystick");
            updateJoystick(x, y);
            return;
        }

        String zone = hitButton(x, y, w, h, s);
        if (zone != null) {
            pointerZones.put(id, zone);
            pressZone(zone);
            return;
        }

        int slot = hitHotbar(x, y, w, h);
        if (slot > 0) {
            String slotZone = "slot" + slot;
            pointerZones.put(id, slotZone);
            pressZone(slotZone);
            return;
        }
